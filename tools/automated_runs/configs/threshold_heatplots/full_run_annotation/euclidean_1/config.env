# Specify Parameters for pipeline execution. More information in pipeline/README.md

# general
result_dir=../apodictus_eval/results/full_run_annotation/euclidean_1/

# S0: usage extraction
s0_precomputed="../../data/dev3/raw_usages"

# S1: unrecorded usage detection
dictionary_s1="../../data/dev3/dictionaries/ode_dictionary.tsv"
threshold_s1=-1000.0
max_usage_length_s1=512
single_feature_s1="euclidean_1"
max_prob_s1=45

# S3: find lemur evidence
dictionary_s3="../../data/dev3/dictionaries/lemur_dictionary.tsv"
threshold_s3=1000.0
max_usage_length_s3=512
single_feature_s3="euclidean_1"
max_prob_s3=45

# S2: sense definition generation
use_small_config=False