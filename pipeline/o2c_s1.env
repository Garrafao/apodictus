# general
result_dir="data/results/s1"

# S1: unrecorded usage detection
dictionary="../data/dev3/dictionaries/ode_dictionary.tsv"
usages="data/results/extracted_usages/**/*usages_shuffle.tsv.zst"
usages_info_file="data/results/extracted_usages/info.tsv" # path to info.tsv file of usage extraction for sorting results
threshold=0.19
model_weights="outlier2cluster/o2c/data/models/NSD/NSD_own_dev.pkl"
max_usage_length=512
delete_embeddings=TRUE # clear embeddings before execution to start in a clean state