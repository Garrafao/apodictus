# Specify Parameters for pipeline execution. More information in pipeline/README.md

# general
result_dir="data/results_trial1"

# S0: usage extraction
trial_corpus="../data/trial1_pipeline_inputs/corpus.tar.zst"
trial_sources="../data/trial1_pipeline_inputs/sources.tar.zst"
headword_files=("../data/trial1_pipeline_inputs/headwords.txt")
corpus_filter="2*.tar"
total_usage_limit=10000
context_range=150
random_state=464

# S1: unrecorded usage detection
dictionary_s1="../data/trial1_pipeline_inputs/ode_dictionary.tsv"
threshold_s1=0.19
model_weights_s1="outlier2cluster/o2c/data/models/NSD/NSD_own_dev.pkl"
max_usage_length_s1=512

# S3: find lemur evidence
dictionary_s3="../data/trial1_pipeline_inputs/lemur_dictionary.tsv"
threshold_s3=0.4
model_weights_s3="outlier2cluster/o2c/data/models/NSD/NSD_own_dev.pkl"
max_usage_length_s3=512

