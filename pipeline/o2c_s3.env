# general
result_dir="data/results/s3"

# S3: unrecorded usage detection
dictionary="../data/dev3/dictionaries/lemur_dictionary.tsv"
usages="data/results/s1/unrecorded.tsv"
usages_info_file="data/results/extracted_usages/info.tsv" # path to info.tsv file of usage extraction for sorting results
threshold=0.4
model_weights="outlier2cluster/o2c/data/models/NSD/NSD_own_dev.pkl"
max_usage_length=512
delete_embeddings=FALSE # reuse and update embeddings from previous execution (s3 and s1 have big overlap in usages)